{
  "name": "file-quiz-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quiz app whose questions are loaded from PDF, DOCX, DOC, XLSX and CSV files",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --include \"data/questions/**/*\" server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "translator": "docker compose up libretranslate",
    "test": "tsx --test server/quiz.test.ts",
    "translator:up": "docker compose up -d libretranslate",
    "translator:logs": "docker compose logs -f libretranslate",
    "translator:down": "docker compose stop libretranslate",
    "ports:free": "node scripts/free-ports.mjs 3001 5173",
    "preflight": "node scripts/preflight.mjs",
    "dev:with-translator": "cross-env LIBRETRANSLATE_URL=http://localhost:5001 QUIZ_LANGUAGE=sv npm run dev",
    "dev:all": "npm run preflight && npm run translator:up && npm run dev:with-translator",
    "dev:all:force": "npm run ports:free && npm run dev:all"
  },
  "dependencies": {
    "exceljs": "^3.4.0",
    "mammoth": "^0.3.29",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
